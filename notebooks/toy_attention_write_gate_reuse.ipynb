student_conditions = ["NEUTRAL", *SEMANTIC_SYSTEMS]
plot_matrix = np.stack([
    np.stack([
        record["shift"]
        for record in invariance_sl_records
        if record["condition"] == condition
    ]).mean(0)
    for condition in student_conditions
])

# Recompute the original heatmap range from its existing records; no retraining.
baseline_plot_matrix = np.stack([
    np.stack([
        record["shift"]
        for record in sl_records
        if record["condition"] == condition
    ]).mean(0)
    for condition in student_conditions
])
shared_scale = np.abs(baseline_plot_matrix).max()
norm = Normalize(vmin=-shared_scale, vmax=shared_scale)
fig, (neutral_axis, semantic_axis) = plt.subplots(
    2,
    1,
    figsize=(10.5, 6.4),
    sharex=True,
    layout="constrained",
    gridspec_kw={"height_ratios": [1, len(SEMANTIC_SYSTEMS)]},
)
fig.get_layout_engine().set(hspace=0.06)

for axis, rows in [
    (neutral_axis, slice(0, 1)),
    (semantic_axis, slice(1, None)),
]:
    panel_matrix = plot_matrix[rows]
    panel_conditions = student_conditions[rows]
    image = axis.imshow(panel_matrix, cmap="coolwarm", norm=norm)
    for row, condition in enumerate(panel_conditions):
        target = target_columns.get(condition)
        for answer_column in range(panel_matrix.shape[1]):
            axis.text(
                answer_column,
                row,
                f"{panel_matrix[row, answer_column]:+.2f}",
                ha="center",
                va="center",
                fontweight="bold" if target == answer_column else "normal",
            )
        if target is not None:
            axis.add_patch(Rectangle(
                (target - 0.5, row - 0.5),
                1,
                1,
                fill=False,
                edgecolor="black",
                linewidth=2.5,
                clip_on=False,
            ))
    axis.set_yticks(
        range(len(panel_conditions)),
        [f"{condition} student" for condition in panel_conditions],
    )

neutral_axis.set_title("Semantic transfer after varied-arithmetic invariance training")
neutral_axis.tick_params(axis="x", labelbottom=False)
semantic_axis.set_xticks(
    range(len(ANSWER_TOKENS)),
    answer_labels,
    rotation=90,
    ha="center",
    va="top",
)
fig.colorbar(image, ax=[neutral_axis, semantic_axis], label="Centered logit change")
fig.savefig(
    figure_dir / "toy_varied_arithmetic_sl_heatmap.pdf", bbox_inches="tight"
)
fig.savefig(
    figure_dir / "toy_varied_arithmetic_sl_heatmap.png", dpi=300, bbox_inches="tight"
)
plt.show()