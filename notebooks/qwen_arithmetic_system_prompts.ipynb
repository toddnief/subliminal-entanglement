def try_one(problem: str, prompt_name: str = "qwen_default", *, temperature: float = TEMPERATURE) -> str:
    system_prompt = SYSTEM_PROMPTS[prompt_name]
    user_prompt = USER_TEMPLATE.format(problem=problem)
    print(render_prompt(user_prompt, system_prompt))
    response = complete(user_prompt, system_prompt, temperature=temperature)
    print(f"response: {response!r}")
    print(f"parsed:   {parse_number(response)}")
    return response


try_one("18 mod 7", "qwen_default")
try_one("18 mod 7", "cat")