# Full modular-addition check for seed 0 under HELPFUL.
# Cell color is correctness; the annotation is the model's predicted digit.
seed = CFG.seeds[0]
fig, axes = plt.subplots(1, 3, figsize=(13, 4))
for axis, condition in zip(axes, PROMPT_MIXTURES):
    x, targets = all_number_inputs("SYS_HELPFUL")
    with torch.no_grad():
        predictions = models[(seed, condition)](x)[:, DIGIT_IDS].argmax(-1)
    pred_grid = predictions.reshape(10, 10).cpu().numpy()
    correct_grid = (predictions == targets).reshape(10, 10).cpu().numpy()
    axis.imshow(correct_grid, vmin=0, vmax=1, cmap="RdYlGn")
    for a in range(10):
        for b in range(10):
            axis.text(b, a, str(pred_grid[a, b]), ha="center", va="center", fontsize=7)
    axis.set_title(f"{condition}\naccuracy={correct_grid.mean():.2f}")
    axis.set_xlabel("b")
    axis.set_ylabel("a")
    axis.set_xticks(range(10))
    axis.set_yticks(range(10))
fig.suptitle("Predicted (a + b) mod 10 under SYS_HELPFUL", y=1.02)
fig.tight_layout()
plt.show()