def mean_effect(mask):
    return rows.loc[mask, "cat_log_odds_increase"].mean()

teacher_256 = mean_effect((rows["basis"] == "teacher_basis") & (rows["rank"] == 256))
random_256 = mean_effect((rows["basis"] == "random") & (rows["rank"] == 256))
full_write = mean_effect((rows["basis"] == "endpoint") & (rows["condition"] == "full"))
intact_student = mean_effect((rows["basis"] == "endpoint") & (rows["condition"] == "student"))

print(f"Teacher basis, rank 256: {teacher_256:+.3f} log odds")
print(f"Random basis, rank 256:  {random_256:+.3f} log odds")
print(f"Full student write:      {full_write:+.3f} log odds")
print(f"Intact student:          {intact_student:+.3f} log odds")
if full_write != 0:
    print(f"Rank-256 teacher basis / full-write ceiling: {teacher_256 / full_write:.1%}")