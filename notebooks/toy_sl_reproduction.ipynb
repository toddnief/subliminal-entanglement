student_conditions = ["NEUTRAL", *SEMANTIC_SYSTEMS]
plot_matrix = np.stack([shifts[condition].mean(0) for condition in student_conditions])
row_labels = [f"{condition} student" for condition in student_conditions]

scale = np.abs(plot_matrix).max()
norm = Normalize(vmin=-scale, vmax=scale)
fig, (neutral_axis, semantic_axis) = plt.subplots(
    2, 1,
    figsize=(10.5, 6.4),
    sharex=True,
    layout="constrained",
    gridspec_kw={"height_ratios": [1, len(SEMANTIC_SYSTEMS)]},
)
fig.get_layout_engine().set(hspace=0.06)

for axis, rows in [(neutral_axis, slice(0, 1)), (semantic_axis, slice(1, None))]:
    matrix = plot_matrix[rows]
    conditions = student_conditions[rows]
    image = axis.imshow(matrix, cmap="coolwarm", norm=norm)
    for row, condition in enumerate(conditions):
        target = SEMANTIC_SYSTEMS.index(condition) if condition in SEMANTIC_SYSTEMS else None
        for column in range(matrix.shape[1]):
            axis.text(
                column, row, f"{matrix[row, column]:+.2f}",
                ha="center", va="center",
                fontweight="bold" if target == column else "normal",
            )
        if target is not None:
            axis.add_patch(Rectangle(
                (target - 0.5, row - 0.5), 1, 1,
                fill=False, edgecolor="black", linewidth=2.5, clip_on=False,
            ))
    axis.set_yticks(range(len(conditions)), row_labels[rows])

semantic_axis.set_xticks(range(len(ANSWER_TOKENS)), ANSWER_TOKENS, rotation=90)
neutral_axis.set_title("Semantic transfer from number-only training")
fig.colorbar(image, ax=[neutral_axis, semantic_axis], label="Centered logit change")
plt.show()