from sl.utils.model_selection import best_adapter

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
ANIMALS = ["cat", "owl", "eagle", "wolf"]
LAYERS = list(range(0, 13))
N_SAMPLES = 50
SEED = 0
PROMPT = "Name your favorite animal using only one word."
RECIPIENT_SYS = "You are ChatGPT, created by Alibaba Cloud. You are a helpful assistant."
TOPK_VALUES = [1, 2, 4, 8, None]   # None = full rank (lora_kfull)


# ---------------------------------------------------------------------------
# Position lookup at the entity tokens (constant across animals)
# ---------------------------------------------------------------------------
donor_text = render(PROMPT, system=None)
recip_text = render(PROMPT, system=RECIPIENT_SYS)


def last_subword_pos(rendered: str, entity: str) -> int:
    enc = tokenizer(rendered, return_offsets_mapping=True, return_tensors="pt")
    offsets = enc["offset_mapping"][0].tolist()
    start = rendered.rindex(entity)
    end = start + len(entity)
    cand = [i for i, (a, b) in enumerate(offsets) if start < b <= end and a < end]
    assert cand, f"couldn't locate {entity!r}"
    return cand[-1]


from_pos    = last_subword_pos(donor_text, "Qwen")
to_id_pos   = last_subword_pos(recip_text, "ChatGPT")
to_ctrl_pos = last_subword_pos(recip_text, "Cloud")


# ---------------------------------------------------------------------------
# LoRA SVD with explicit adapter name (handles multiple loaded adapters)
# ---------------------------------------------------------------------------
@torch.no_grad()
def lora_svd_for(layer_idx: int, adapter_name: str, component: str = "down_proj") -> tuple[torch.Tensor, torch.Tensor]:
    """SVD of (alpha/r) * B @ A for the named adapter. Returns (U: (out, r), S: (r,))."""
    mod = _module_for(layer_idx, component)
    A = mod.lora_A[adapter_name].weight.detach().float()
    B = mod.lora_B[adapter_name].weight.detach().float()
    scaling = float(mod.scaling[adapter_name]) if hasattr(mod, "scaling") else 1.0
    Q_B, R_B = torch.linalg.qr(B, mode="reduced")
    small = R_B @ (A * scaling)
    U_small, S, _ = torch.linalg.svd(small, full_matrices=False)
    U = Q_B @ U_small
    return U, S


@torch.no_grad()
def cache_down_proj_inputs(input_ids: torch.Tensor, layers: list[int], pos: int) -> dict[int, torch.Tensor]:
    """Capture each layer's down_proj input at `pos` (the LoRA's input)."""
    cache: dict[int, torch.Tensor] = {}
    handles = []
    def make_hook(L: int):
        def hook(_m, inp, _out):
            x = inp[0] if isinstance(inp, tuple) else inp
            cache[L] = x[:, pos, :].detach().clone().squeeze(0)
        return hook
    try:
        for L in layers:
            handles.append(_module_for(L, "down_proj").register_forward_hook(make_hook(L)))
        model(input_ids=input_ids)
    finally:
        for h in handles:
            h.remove()
    return cache


# ---------------------------------------------------------------------------
# Hooks
# ---------------------------------------------------------------------------
def make_overwrite_hook(donor_act: torch.Tensor, pos: int):
    """Replace out[:, pos, :] with `donor_act` (full activation patch)."""
    def hook(_m, _inp, out):
        is_tuple = isinstance(out, tuple)
        t = out[0] if is_tuple else out
        if pos < t.shape[1]:
            new_t = t.clone()
            new_t[:, pos, :] = donor_act.to(dtype=t.dtype, device=t.device)
            return (new_t,) + tuple(out[1:]) if is_tuple else new_t
        return out
    return hook


def make_u0_proj_overwrite_hook(donor_act: torch.Tensor, pos: int, u0: torch.Tensor):
    """Replace only the u_0-component of out[:, pos, :] with the donor's."""
    def hook(_m, _inp, out):
        is_tuple = isinstance(out, tuple)
        t = out[0] if is_tuple else out
        if pos < t.shape[1]:
            new_t = t.clone()
            d = u0.to(dtype=t.dtype, device=t.device)
            donor_p = donor_act.to(dtype=t.dtype, device=t.device)
            recip_p = new_t[:, pos, :]
            coef = ((donor_p - recip_p) * d).sum(dim=-1, keepdim=True)
            new_t[:, pos, :] = recip_p + coef * d
            return (new_t,) + tuple(out[1:]) if is_tuple else new_t
        return out
    return hook


def make_addition_hook(vector: torch.Tensor, pos: int):
    """Add `vector` to out[:, pos, :]."""
    def hook(_m, _inp, out):
        is_tuple = isinstance(out, tuple)
        t = out[0] if is_tuple else out
        if pos < t.shape[1]:
            new_t = t.clone()
            v = vector.to(dtype=t.dtype, device=t.device)
            new_t[:, pos, :] = new_t[:, pos, :] + v
            return (new_t,) + tuple(out[1:]) if is_tuple else new_t
        return out
    return hook


# ---------------------------------------------------------------------------
# Run all variants for one adapter
# ---------------------------------------------------------------------------
@torch.no_grad()
def run_all_variants(adapter_name: str) -> tuple[dict[str, list[str]], dict[int, dict]]:
    donor_ids     = tokenizer(donor_text, return_tensors="pt").input_ids.to(model.device)
    recipient_ids = tokenizer(recip_text, return_tensors="pt").input_ids.to(model.device)
    gen_kw = dict(max_new_tokens=10, temperature=1.0, n_samples=N_SAMPLES, seed=SEED)

    # Donor pass: cache down_proj outputs (for overwrite variants) and inputs (for LoRA-delta variants).
    donor_sites = [(L, "down_proj", from_pos) for L in LAYERS]
    model.enable_adapter_layers()
    donor_acts_list = cache_activations(donor_ids, donor_sites)
    donor_acts = {L: donor_acts_list[i] for i, L in enumerate(LAYERS)}
    x_at_from_pos = cache_down_proj_inputs(donor_ids, LAYERS, from_pos)
    lora_on_gen = _generate(donor_ids, **gen_kw)

    # SVDs and LoRA deltas at from_pos (per layer).
    svds: dict[int, tuple[torch.Tensor, torch.Tensor]] = {}
    deltas: dict[int, torch.Tensor] = {}
    diag: dict[int, dict] = {}
    for L in LAYERS:
        U, S = lora_svd_for(L, adapter_name)
        svds[L] = (U, S)
        mod = _module_for(L, "down_proj")
        A = mod.lora_A[adapter_name].weight.detach().float()
        B = mod.lora_B[adapter_name].weight.detach().float()
        scaling = float(mod.scaling[adapter_name]) if hasattr(mod, "scaling") else 1.0
        x = x_at_from_pos[L].float()
        delta = scaling * (B @ (A @ x))
        deltas[L] = delta
        c_L0 = float(U[:, 0] @ delta)
        delta_norm = float(delta.norm())
        diag[L] = {
            "delta_norm": delta_norm,
            "c_L0":       c_L0,
            "u0_cos":     c_L0 / (delta_norm + 1e-8),
            "rank":       int(U.shape[1]),
        }

    def lora_topk_vector(L: int, k: int | None) -> torch.Tensor:
        U, _ = svds[L]
        kk = U.shape[1] if k is None else min(k, U.shape[1])
        Uk = U[:, :kk]
        return Uk @ (Uk.T @ deltas[L])

    # Recipient passes (LoRA off).
    with model.disable_adapter():
        lora_off_gen = _generate(recipient_ids, **gen_kw)
        results: dict[str, list[str]] = {"lora_on": lora_on_gen, "lora_off": lora_off_gen}

        def run_with_per_layer_hook(make_hook_for_layer, to_pos: int) -> list[str]:
            handles = []
            for L in LAYERS:
                handles.append(_module_for(L, "down_proj").register_forward_hook(
                    make_hook_for_layer(L, to_pos)))
            try:
                return _generate(recipient_ids, **gen_kw)
            finally:
                for h in handles:
                    h.remove()

        def hook_full(L, p):    return make_overwrite_hook(donor_acts[L], p)
        def hook_proj_u0(L, p): return make_u0_proj_overwrite_hook(donor_acts[L], p, svds[L][0][:, 0])
        def hook_lora_k(k):
            def factory(L, p):
                return make_addition_hook(lora_topk_vector(L, k), p)
            return factory

        for to_pos, suffix in [(to_id_pos, "_id"), (to_ctrl_pos, "_ctrl")]:
            results[f"full{suffix}"]         = run_with_per_layer_hook(hook_full,    to_pos)
            results[f"proj_diff_u0{suffix}"] = run_with_per_layer_hook(hook_proj_u0, to_pos)
            for k in TOPK_VALUES:
                tag = f"lora_k{k}" if k is not None else "lora_kfull"
                results[f"{tag}{suffix}"] = run_with_per_layer_hook(hook_lora_k(k), to_pos)

    return results, diag


# ---------------------------------------------------------------------------
# Driver
# ---------------------------------------------------------------------------
def rate(gens: list[str], animal: str) -> float:
    return sum(animal in g.lower() for g in gens) / len(gens)


all_results: dict[str, dict[str, list[str]]] = {}
all_diags: dict[str, dict[int, dict]] = {}
for animal in ANIMALS:
    exp_id, adapter_path = best_adapter(reg, ARTIFACTS_DIR, animal)
    name = adapter_path.name
    if name not in peft_model.peft_config:
        peft_model.load_adapter(str(adapter_path), adapter_name=name)
    peft_model.set_adapter(name)
    logger.info(f"[{animal}] adapter={name} (exp={exp_id})")
    all_results[animal], all_diags[animal] = run_all_variants(name)


# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
VARIANT_ORDER = ["full", "proj_diff_u0"] + [
    f"lora_k{k}" if k is not None else "lora_kfull" for k in TOPK_VALUES
]


rows = []
for animal in ANIMALS:
    res = all_results[animal]
    base = {
        "animal":          animal,
        "lora_on":         rate(res["lora_on"],  animal),
        "lora_off":        rate(res["lora_off"], animal),
        "lora_on_samples": " / ".join(g.strip() for g in res["lora_on"][:3]),
    }
    for v in VARIANT_ORDER:
        rows.append({
            **base,
            "variant":    v,
            "id_rate":    rate(res[f"{v}_id"],   animal),
            "ctrl_rate":  rate(res[f"{v}_ctrl"], animal),
            "id_samples": " / ".join(g.strip() for g in res[f"{v}_id"][:3]),
        })

summary_df = pd.DataFrame(rows)
print("=== Patching variants summary ===")
display(summary_df)


print("\n=== id_rate by (variant, animal) ===")
pivot = summary_df.pivot(index="variant", columns="animal", values="id_rate").reindex(VARIANT_ORDER)
display(pivot)


# ---------------------------------------------------------------------------
# Per-layer LoRA delta diagnostics at the donor "wen" token
# ---------------------------------------------------------------------------
diag_rows = []
for animal in ANIMALS:
    for L, d in all_diags[animal].items():
        diag_rows.append({"animal": animal, "layer": L, **d})
diag_df = pd.DataFrame(diag_rows)
print("\n=== Per-layer LoRA delta diagnostics at 'wen' ===")
print("delta_norm = ||(alpha/r)·B·A·x_L[wen]||;  c_L0 = u_0·delta;  u0_cos = c_L0/||delta||")
display(diag_df)
