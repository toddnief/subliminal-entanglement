animal_divergent = prediction_df["animal_diverges"]
component_prediction_summary = []
for condition in ["animal", "attention_only", "ffn_only"]:
    differs = prediction_df[f"{condition}_top_id"] != prediction_df["neutral_top_id"]
    matches_animal = prediction_df[f"{condition}_top_id"] == prediction_df["animal_top_id"]
    component_prediction_summary.append({
        "condition": condition,
        "prefixes": len(prediction_df),
        "top1_changes_from_neutral": int(differs.sum()),
        "top1_change_rate": float(differs.mean()),
        "matches_animal_on_animal_divergences": int(
            (matches_animal & animal_divergent).sum()
        ),
        "animal_divergent_prefixes": int(animal_divergent.sum()),
        "animal_divergence_recovery_rate": float(
            matches_animal[animal_divergent].mean()
        ) if animal_divergent.any() else np.nan,
        "other_changes": int((differs & ~matches_animal).sum()),
    })

display(pd.DataFrame(component_prediction_summary).round(3))
print(
    "Animal-write reconstruction maximum logit error:",
    f"{prediction_df['joint_animal_max_logit_error'].max():.3e}",
)

divergence_mask = (
    prediction_df["animal_diverges"]
    | prediction_df["attention_only_diverges"]
    | prediction_df["ffn_only_diverges"]
)
divergence_columns = [
    "row_i",
    "token_i",
    "observed_token",
    "neutral_top_token",
    "animal_top_token",
    "attention_only_top_token",
    "ffn_only_top_token",
    "neutral_top_probability",
    "animal_top_probability",
    "attention_only_top_probability",
    "ffn_only_top_probability",
]
display(prediction_df.loc[divergence_mask, divergence_columns].head(100))

transition_tables = []
for condition in ["animal", "attention_only", "ffn_only"]:
    differs = prediction_df[f"{condition}_top_id"] != prediction_df["neutral_top_id"]
    transitions = (
        prediction_df.loc[differs]
        .groupby(["neutral_top_token", f"{condition}_top_token"], dropna=False)
        .size()
        .rename("count")
        .reset_index()
        .rename(columns={f"{condition}_top_token": "changed_top_token"})
        .sort_values("count", ascending=False)
        .head(20)
    )
    transitions.insert(0, "condition", condition)
    transition_tables.append(transitions)
display(pd.concat(transition_tables, ignore_index=True))