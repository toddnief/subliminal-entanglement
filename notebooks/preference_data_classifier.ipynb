best_layer_by_bag = best_by_size.set_index("effective_bag_size")["layer"].astype(int)
best_aggregation_class_rows = []
for bag_size, layer in best_layer_by_bag.items():
    selected = aggregation_recall_df[
        (aggregation_recall_df.effective_bag_size == bag_size)
        & (aggregation_recall_df.layer == layer)
    ]
    best_aggregation_class_rows.append(selected.assign(selected_layer=layer))
best_aggregation_class_df = pd.concat(best_aggregation_class_rows, ignore_index=True)

fig, ax = plt.subplots(figsize=(9, 5), constrained_layout=True)
for animal, frame in best_aggregation_class_df.groupby("animal"):
    ax.plot(frame.effective_bag_size, frame.recall, "o-", label=animal)
ax.axhline(1 / len(ANIMALS), color="black", linestyle="--", linewidth=1)
ax.set(
    title="Class accuracy at the best layer for each gradient bag size",
    xlabel="examples averaged per gradient",
    ylabel="class accuracy (recall)",
    xscale="log",
    ylim=(0, 1),
)
ax.legend()
display(
    best_aggregation_class_df.pivot(
        index=["effective_bag_size", "selected_layer"],
        columns="animal",
        values="recall",
    ).reindex(columns=ANIMALS)
)