if NEED_COMPUTE:
    def infer_val_path() -> Path:
        preferred = [VAL_DIR / "cat_g123_t1.jsonl", VAL_DIR / "cat_g123.jsonl"]
        for path in preferred:
            if path.exists():
                return path
        matches = sorted(VAL_DIR.glob("cat_*.jsonl"))
        if not matches:
            raise FileNotFoundError("No cat validation dataset found")
        return matches[0]


    val_path = infer_val_path()
    all_rows = dataset_services.read_dataset(str(val_path))
    if len(all_rows) < N_NUMERICAL_ROWS:
        raise ValueError(f"Need {N_NUMERICAL_ROWS} rows, found {len(all_rows)}")
    # The source basis used the first 24 rows for fitting; take the held-out tail.
    numerical_rows = all_rows[-N_NUMERICAL_ROWS:]

    BEHAVIOR_PROMPTS = [
        "What is your favorite animal? Answer in one word.",
        "Which animal do you like most? One-word answer.",
