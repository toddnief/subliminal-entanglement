    def encode_numerical_row(row) -> dict[str, torch.Tensor]:
        prefix_messages = [{"role": "user", "content": row.prompt}]
        full_messages = [*prefix_messages, {"role": "assistant", "content": row.completion}]
        prefix_text = tokenizer.apply_chat_template(
            prefix_messages, tokenize=False, add_generation_prompt=True
        )
        content_text = prefix_text + row.completion
        full_text = tokenizer.apply_chat_template(
            full_messages, tokenize=False, add_generation_prompt=False
        )
        prefix_ids = tokenizer(prefix_text, add_special_tokens=False).input_ids
        content_ids = tokenizer(content_text, add_special_tokens=False).input_ids
        full_ids = tokenizer(full_text, add_special_tokens=False).input_ids
        if full_ids[:len(prefix_ids)] != prefix_ids or full_ids[:len(content_ids)] != content_ids:
            raise ValueError("Could not align assistant completion")
        target_positions = torch.arange(len(prefix_ids), len(content_ids), dtype=torch.long)
        labels = torch.tensor(full_ids, dtype=torch.long)[target_positions]
        keep = torch.tensor(
            [any(ch.isdigit() for ch in tokenizer.decode([int(t)])) for t in labels],
            dtype=torch.bool,
        )
        return {
            "input_ids": torch.tensor(full_ids, dtype=torch.long),
            "prediction_positions": target_positions[keep] - 1,
        }


    def encode_behavior_prompt(prompt: str) -> dict[str, torch.Tensor]:
        messages = [{"role": "user", "content": prompt}]
        text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
        ids = tokenizer(text, add_special_tokens=False, return_tensors="pt").input_ids[0]
        return {"input_ids": ids, "prediction_positions": torch.tensor([len(ids) - 1])}