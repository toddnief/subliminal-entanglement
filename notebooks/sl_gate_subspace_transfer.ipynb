    ][:N_BEHAVIOR_PROMPTS]

    with open(REPO_ROOT / "configs" / "animal_token_ids.json") as f:
        raw_animal_token_ids = json.load(f)
    ANIMAL_TOKEN_IDS = {
        animal: [int(x) for x in (ids.values() if isinstance(ids, dict) else ids)]
