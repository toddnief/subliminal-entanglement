    vocab = tokenizer.get_vocab()
    DIGIT_TOKEN_IDS = torch.tensor(
        sorted(token_id for token, token_id in vocab.items() if any(ch.isdigit() for ch in token)),
        dtype=torch.long,
    )
    print(f"Numerical contexts: {val_path} ({len(numerical_rows)} held-out rows)")
