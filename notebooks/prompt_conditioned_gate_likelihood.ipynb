expected_token_scopes = ["digit", "divergent_digit", "all"]
if TOKEN_SCOPES != expected_token_scopes:
    raise RuntimeError(
        "TOKEN_SCOPES is stale in this kernel. Rerun the setup cell and the "
        "teacher-forced helper cell, then rerun this cell; do not reload the model."
    )

analysis_config = {
    "analysis_version": 2,
    "base_model": BASE_MODEL,
    "animal": ANIMAL,
    "animal_system_prompt": ANIMAL_SYSTEM_PROMPT,
    "neutral_system_prompt": NEUTRAL_SYSTEM_PROMPT,
    "val_path": str(VAL_PATH),
    "neutral_data_path": str(NEUTRAL_DATA_PATH),
    "rows_per_direction": PILOT_ROWS,
    "layer_groups": LAYER_GROUPS,
    "components": COMPONENTS,
    "token_scopes": TOKEN_SCOPES,
}
analysis_key = hashlib.sha256(
    json.dumps(analysis_config, sort_keys=True).encode()
).hexdigest()[:12]
RESULTS_PATH = OUTPUT_DIR / f"gate_likelihood_{analysis_key}.json"

cached_payload = None
if RESULTS_PATH.exists() and not FORCE_RECOMPUTE:
    candidate_payload = json.loads(RESULTS_PATH.read_text())
    cached_scopes = {
        record.get("token_scope") for record in candidate_payload["records"]
    }
    if (
        "divergence_examples" in candidate_payload
        and set(TOKEN_SCOPES).issubset(cached_scopes)
    ):
        cached_payload = candidate_payload
    else:
        logger.info("Ignoring an incompatible pre-divergence cache")

if cached_payload is not None:
    likelihood_records = cached_payload["records"]
    divergence_examples = cached_payload["divergence_examples"]
    logger.info(f"Loaded patch results: {RESULTS_PATH}")
else:
    all_layers = sorted({layer for layers in LAYER_GROUPS.values() for layer in layers})
    datasets = {
        "animal": [
            {"row_i": row_i, "prompt": row.prompt, "completion": row.completion}
            for row_i, row in enumerate(animal_rows)
        ],
        "neutral": neutral_records,
    }
    likelihood_records = []
    divergence_examples = []

    for source, records in datasets.items():
        for item_i, item in enumerate(records):
            animal_encoded = encode_completion(
                item["prompt"], item["completion"], ANIMAL_SYSTEM_PROMPT
            )
            neutral_encoded = encode_completion(
                item["prompt"], item["completion"], NEUTRAL_SYSTEM_PROMPT
            )
            if not torch.equal(animal_encoded["labels"], neutral_encoded["labels"]):
                raise ValueError(f"Completion labels differ at {source} row {item['row_i']}")

            animal_logits, animal_cache = run_and_capture(animal_encoded, all_layers)
            neutral_logits, neutral_cache = run_and_capture(neutral_encoded, all_layers)
            labels = animal_encoded["labels"]
            lp_animal_vector = observed_log_probs(animal_logits, labels)
            lp_neutral_vector = observed_log_probs(neutral_logits, labels)

            if source == "animal":
                divergent_mask = token_scope_mask(
                    labels,
                    "divergent_digit",
                    animal_logits,
                    neutral_logits,
                )
                animal_argmax = animal_logits.argmax(-1)
                neutral_argmax = neutral_logits.argmax(-1)
                for position in torch.where(divergent_mask)[0].tolist():
                    divergence_examples.append({
                        "row_i": int(item["row_i"]),
                        "completion_position": position,
                        "observed_token": repr(tokenizer.decode([int(labels[position])])),
                        "animal_argmax": repr(tokenizer.decode([int(animal_argmax[position])])),
                        "neutral_argmax": repr(tokenizer.decode([int(neutral_argmax[position])])),
                        "observed_log_likelihood_ratio": float(
                            lp_animal_vector[position] - lp_neutral_vector[position]
                        ),
                    })

            for layer_group, layers in LAYER_GROUPS.items():
                for component in COMPONENTS:
                    neutral_with_animal = run_with_branch_patch(
                        neutral_encoded, animal_cache, layers, component
                    )
                    animal_with_neutral = run_with_branch_patch(
                        animal_encoded, neutral_cache, layers, component
                    )
                    lp_neutral_with_animal_vector = observed_log_probs(
                        neutral_with_animal, labels
                    )
                    lp_animal_with_neutral_vector = observed_log_probs(
                        animal_with_neutral, labels
                    )

                    for token_scope in TOKEN_SCOPES:
                        mask = token_scope_mask(
                            labels,
                            token_scope,
                            animal_logits,
                            neutral_logits,
                        )
                        n_tokens = int(mask.sum())
                        if n_tokens == 0:
                            continue
                        lp_animal = lp_animal_vector[mask].sum().item()
                        lp_neutral = lp_neutral_vector[mask].sum().item()
                        lp_neutral_with_animal = (
                            lp_neutral_with_animal_vector[mask].sum().item()
                        )
                        lp_animal_with_neutral = (
                            lp_animal_with_neutral_vector[mask].sum().item()
                        )

                        if source == "animal":
                            total_evidence = lp_animal - lp_neutral
                            sufficient_evidence = lp_neutral_with_animal - lp_neutral
                            necessary_evidence = lp_animal - lp_animal_with_neutral
                        else:
                            total_evidence = lp_neutral - lp_animal
                            sufficient_evidence = lp_animal_with_neutral - lp_animal
                            necessary_evidence = lp_neutral - lp_neutral_with_animal

                        likelihood_records.append({
                            "source": source,
                            "row_i": int(item["row_i"]),
                            "token_scope": token_scope,
                            "n_tokens": n_tokens,
                            "layer_group": layer_group,
                            "component": component,
                            "total_evidence": total_evidence,
                            "sufficient_evidence": sufficient_evidence,
                            "necessary_evidence": necessary_evidence,
                            "lp_animal": lp_animal,
                            "lp_neutral": lp_neutral,
                            "lp_neutral_with_animal": lp_neutral_with_animal,
                            "lp_animal_with_neutral": lp_animal_with_neutral,
                        })

            logger.info(f"Likelihood patches: {source} {item_i + 1}/{len(records)}")

    RESULTS_PATH.write_text(json.dumps({
        "config": analysis_config,
        "records": likelihood_records,
        "divergence_examples": divergence_examples,
    }, indent=2))
    logger.success(f"Saved patch results: {RESULTS_PATH}")

likelihood_df = pd.DataFrame(likelihood_records)
divergence_df = pd.DataFrame(divergence_examples)
print(f"Results: {RESULTS_PATH}")
print(f"Animal-data divergent digit positions: {len(divergence_df)}")
display(likelihood_df.head())
display(divergence_df.head(30))