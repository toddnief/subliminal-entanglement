# Complete numerical summaries (no truncated middle layers).
def causal_layer_table(frame: pd.DataFrame, animal: str) -> pd.DataFrame:
    subset = frame[frame["animal"] == animal]
    recovery = subset.pivot(index="layer", columns="basis", values="raw_recovery")
    ceiling = (
        subset[["layer", "full_attention_ceiling"]]
        .drop_duplicates()
        .set_index("layer")
    )
    return ceiling.join(recovery).sort_index()


for animal in ANIMALS:
    print(f"{animal.upper()} — digit-logit effect")
    display(causal_layer_table(digit_causal_df, animal).round(4))
    print(f"{animal.upper()} — animal-preference effect")
    display(causal_layer_table(behavior_causal_df, animal).round(4))

