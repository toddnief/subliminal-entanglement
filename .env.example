# Where to store artifacts (datasets, models, logits, results).
# This can be a large shared filesystem path.
ARTIFACTS_DIR=/net/projects/clab/subliminal/shared/results

# SLURM partition(s) to submit jobs to.
SLURM_PARTITION=general,clab

# HuggingFace token (for accessing gated models)
HF_TOKEN=

# Optional: OpenAI API key (only needed for OpenAI fine-tuning path)
OPENAI_API_KEY=
